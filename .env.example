# LLM providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# API key for DeepSeek service (set to enable DeepSeek features)
DEEPSEEK_API_KEY=
# DeepSeek API base URL (default: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Default chat model (namespaced provider/model)
AI_MODEL=openrouter/openai/gpt-5.4-mini

# CV generation model (independent of chat AI_MODEL)
# Must be namespaced as provider/model (e.g. anthropic/sonnet)
TAILOR_MODEL=anthropic/sonnet
# Optional explicit reasoning effort for tailor-cv (none|minimal|low|medium|high|xhigh|max).
# Unset = provider defaults (uneven across Gemini/GPT/DeepSeek — pin for fair A/B).
# OpenRouter: sent as reasoning.effort. DeepSeek direct: mapped to thinking + reasoning_effort
# (none→disabled; minimal|low|medium|high→enabled+high; xhigh|max→enabled+max).
# TAILOR_REASONING_EFFORT=medium
# Eval winner 2026-06-03: highest four-dimension composite score (format + relevance + anti-hallucination + extraction)

# Comma-separated model strings for historical eval helpers; defaults to all candidate models
EVAL_MODELS=deepseek/deepseek-v4-pro,openrouter/qwen/qwen3.7-max,openrouter/xiaomi/mimo-v2.5-pro,openrouter/minimax/minimax-m3,openrouter/google/gemini-3.1-pro-preview,openrouter/openai/gpt-5.4,openrouter/openai/gpt-5.5,anthropic/sonnet,anthropic/opus
# Model for JD metadata extraction in eval pipeline stage 1 (namespaced provider/model)
EVAL_EXTRACTION_MODEL=openrouter/openai/gpt-5.4-mini
# Minimum extraction judge score (0.0–1.0) to proceed to stage 2 CV generation (default 0.7)
EVAL_EXTRACTION_MIN_SCORE=0.7

# SMOKE_WRITE_UNREDACTED=1
# SMOKE_CURATION_MODE=strict
# Default when POST /api/tailor-cv omits curationMode (strict | flexible)
# TAILOR_DEFAULT_CURATION_MODE=strict

AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8192
# Use OpenRouter flex pricing tier by default (true/false)
OPENROUTER_FLEX_ENABLED=true
# Hard ceiling for max_tokens across all providers (default 128000)
AI_MAX_TOKENS_LIMIT=128000
# TTL in ms for the Anthropic Models API cache (default 604800000 = 7 days)
ANTHROPIC_MODEL_CACHE_TTL_MS=604800000

# Rate limiting (burst detection per IP + per shared-secret hash)
# Max requests per IP per window (default 5)
RATE_LIMIT_MAX=5
# Sliding window length in ms (default 60000)
RATE_LIMIT_WINDOW=60000
# Per-shared-secret ceiling (default: floor(RATE_LIMIT_MAX / 2), min 1)
RATE_LIMIT_SECRET_MAX=2
# Max ms to wait for Upstash rate-limit check before fail-closed 503 (default 2000)
RATE_LIMIT_TIMEOUT_MS=2000
# Redis key prefix for rate-limit state (default: ratelimit)
RATE_LIMIT_REDIS_PREFIX=ratelimit
# Upstash Redis REST API (required for distributed rate limiting; from Upstash console → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LangFuse (optional). Prompt/response content is always redacted to [REDACTED] in traces.
LANGFUSE_TRACING=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Max ms to wait for Langfuse span export before continuing (default 5000)
LANGFUSE_FLUSH_TIMEOUT_MS=5000
# Curator prompt cache TTL in seconds for Langfuse prompt.get (default 300)
# LANGFUSE_CURATOR_PROMPT_CACHE_TTL_SECONDS=300

# LangSmith (optional). Prompt/response content is always redacted like Langfuse.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=

# Railway sets PORT automatically
PORT=3000

# Canonical master CV JSON (career PII — never commit real content)
# Prefer embedding JSON in env for Railway/local secrets (MASTER_CV_JSON).
# Alternative: path to a gitignored file (must not be world-readable).
# MASTER_CV_JSON={"name":"..."}
MASTER_CV_PATH=secrets/master_cv.json

# Optional path override for master-cv.schema.json (default: references/json-curator/master-cv.schema.json)
# CV_SCHEMA_PATH=

# globalThis key for master CV preload cache shared across Next.js bundles (default below)
# MASTER_CV_CACHE_KEY=__cccMasterCvCache

# Shared secret for POST /api/tailor-cv — only smoke CLI and CCC backend present this.
# Clients must send: Authorization: Bearer <TAILOR_API_KEY>
# Required in production-like deploys; unset locally without bypass → 503.
TAILOR_API_KEY=

# Local/dev only: skip Bearer auth when set to 1/true. Default off.
# Hard-blocked at server startup (instrumentation) when NODE_ENV=production or
# RAILWAY_ENVIRONMENT/VERCEL_ENV=production — process exits fatally.
# TAILOR_AUTH_INSECURE_BYPASS=1

# Max rightmost x-forwarded-for entries to parse before giving up (default 5)
# TAILOR_MAX_XFF_ENTRIES=5
# Max x-forwarded-for header character length before skipping parse (default 1024)
# TAILOR_MAX_XFF_HEADER_CHARS=1024

# Size limits (JSON curator pipeline) — defaults shown; unset uses these values
# Max inbound POST body bytes before parse (default 65536)
# TAILOR_REQUEST_MAX_BYTES=65536
# Max jobDescription character length (default 50000)
# TAILOR_JD_MAX_CHARS=50000
# Max serialized curated JSON bytes before render (default 512000)
# TAILOR_CURATED_JSON_MAX_BYTES=512000
# Max chars of free-form detail embedded in safe diagnostic / thrown error messages (default 200)
# SAFE_LOG_DETAIL_MAX_CHARS=200
# Max total JSON response bytes including base64 docx (default 2097152)
# TAILOR_RESPONSE_MAX_BYTES=2097152

# Inbox processed-id store (M8.3). Claim ≠ processed. Prefix + TTLs.
# INBOX_REDIS_PREFIX=inbox
# INBOX_CLAIM_TTL_SECONDS=900
# INBOX_PROCESSED_TTL_SECONDS=0
# INBOX_MESSAGE_ID_MAX_CHARS=128
# Serial delay between scan messages in ms (M8.5; 0 disables)
# INBOX_SCAN_BACKOFF_MS=1000
# Abort hung inbox Redis get/set/del (ms). Default 2000, same order as RATE_LIMIT_TIMEOUT_MS.
# INBOX_REDIS_TIMEOUT_MS=2000

# Gmail inbox worker (M8.2 list; later rows reuse the same token)
# Desktop OAuth client (Google Cloud → Gmail API enabled). Never commit tokens.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Operator Gmail label name applied by a filter (not a label id)
# GMAIL_RECRUITER_LABEL=
# Default scope covers list now and drafts in M8.5 (one-shot consent)
# GMAIL_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.modify
# GMAIL_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
# GMAIL_LIST_MAX_RESULTS=50
# GMAIL_LIST_MAX_RESULTS_LIMIT=500
# Abort hung Gmail REST + OAuth token POSTs (ms). Default 15000.
# GMAIL_HTTP_TIMEOUT_MS=15000
# Max wait for npm run gmail:auth loopback callback (ms). Default 300000.
# GMAIL_AUTH_TIMEOUT_MS=300000
# Loopback bind for npm run gmail:auth (127.0.0.1 or ::1 only)
# GMAIL_AUTH_BIND_HOST=127.0.0.1
# Attachment filename on inbox reply drafts (no path separators)
# GMAIL_CV_ATTACHMENT_FILENAME=CV.docx
# Railway cron for the same npm run inbox:scan job lives in railway.inbox-scan.toml
# (05:00 UTC). Not an env var — do not add cronSchedule to railway.toml.

