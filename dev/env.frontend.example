# Overlay for ccc-frontend/.env when CCC runs on :3001 with local mocks.
CCC_API_URL=http://127.0.0.1:3001
TAILOR_API_KEY=local-dev-tailor-api-key
DATABASE_URL=postgresql://ccc:ccc_frontend_dev@127.0.0.1:5432/ccc_frontend
BETTER_AUTH_URL=http://localhost:3000
ALLOW_REGISTRATION=true
