# Overlay on .env.example for local mocks (do not commit real secrets).
# Copy these into .env.local after filling TAILOR_API_KEY and MASTER_CV_PATH.

DEEPSEEK_API_KEY=local-dev-deepseek-key
DEEPSEEK_BASE_URL=http://127.0.0.1:4010
TAILOR_MODEL=deepseek/deepseek-chat
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-upstash-token
PORT=3001
LANGFUSE_TRACING=false

# Optional: copy references/json-curator/master-cv.schema-sample.json to secrets/master_cv.json
# MASTER_CV_PATH=secrets/master_cv.json
# TAILOR_API_KEY=local-dev-tailor-api-key
